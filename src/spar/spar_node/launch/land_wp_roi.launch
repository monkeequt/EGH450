<?xml version='1.0'?>

<launch>

	<!-- =========================================================================== -->
	<!-- ======================== Common Mode Configuration ======================== -->
	<!-- =========================================================================== -->
	
	<!-- True = Emulator | False = Physical -->
	<arg name="emulator_mode" default="False" />
	<!-- UAV Body TF Frame -->
	<arg name="uav_name" default="emulated_uav" />
	<!-- Camera TF Frame -->
	<arg name="camera_name" default="camera" />
	<!-- Global TF Frame -->
	<!-- Emulator = Map -->
	<!-- Physical = Optitrack -->
	<arg name="global_frame" default="map" />
	<!-- Designated Final Landing Marker -->
	<arg name="landing_aruco_id" default="16" />
	<!-- Configure the low battery return % -->
	<param name="battery_threshold" value="0.40"/>

	<!-- =========================================================================== -->
	<!-- ================================ Guidance ================================= -->
	<!-- =========================================================================== -->
	
	<node name="guidance" pkg="spar_node" type="landing" respawn="false" output="screen">
		<!-- Designated landing ArUco marker ID -->
		<param name="landing_aruco_id" type="int" value="$(arg landing_aruco_id)" />
		<!-- Survey Altitude -->
		<param name="surveyAlt" type="double" value="1.5" />
		<!-- Linear and yaw motion velocities -->
		<param name="vel_linear" type="double" value="0.5" />
		<param name="vel_yaw" type="double" value="0.2" />
		<!-- Takeoff and landing parameters -->
		<param name="takeoff_speed" type="double" value="0.5" />
		<param name="land_speed" type="double" value="0.1" />
		<!-- Position and yaw waypoint accuracies -->
		<param name="acc_pos" type="double" value="0.2" />
		<param name="acc_yaw" type="double" value="0.2" />
		<!-- Safe boundary values for O134 -->
		<param name="safeRangeX" type="double" value="4.4" />
		<param name="safeRangeY" type="double" value="3.3" /> 
		<param name="safeRangeZ" type="double" value="4.0" />
		<!-- Spar parameters -->
		<param name="action_topic" type="string" value="spar/flight" />
		<!-- Remappings -->
		<remap from="~/pose" to="uavasr/pose" />
		<remap from="~roi" to="target_detection/roi" />
	</node>

</launch>
